# 실행 시 환경변수로 주입한다. 값은 예시이며, 실제 값은 커밋하지 않는다.

# 주 DB (PostgreSQL)
SPRING_DATASOURCE_SIMULATION_USERNAME=postgres
SPRING_DATASOURCE_SIMULATION_PASSWORD=postgres

# 외부 연계 DB (Tibero, 조회 전용)
SPRING_DATASOURCE_WATERNET_USERNAME=
SPRING_DATASOURCE_WATERNET_PASSWORD=

# JWT 서명 키 (api·batch 동일 값, 32바이트 이상)
JWT_SECRET=
